{
  "name": "gamehub-web",
  "private": true,
  "type": "module",
  "description": "Cliente web de GameHub: SDK TypeScript, UI genérica, UI kit y la app para jugar.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @gamehub/play dev",
    "build": "pnpm --filter @gamehub/play build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
