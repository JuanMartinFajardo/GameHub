// SPDX-License-Identifier: Apache-2.0
// Tests de la biblioteca estándar, escritos en Nomos: un juego trivial cuyos tests prueban las
// funciones de std.

import std.cards.*
import std.dice.*
import std.grid.*
import std.graph.*
import std.boards.*
import std.tricktaking.*
import std.poker.*
import std.betting.*

game StdlibTests {
  players 1
  flow {
    start -> End
    terminal End { payoff: [0] }
  }

  test "std.cards" {
    expect len(french52()) == 52 and len(distinct(french52())) == 52
    expect first(french52()) == Card { suit: Clubs, rank: Rank.Two }
    expect rank_value(Rank.Two) == 2 and rank_value(Rank.Ten) == 10 and rank_value(Rank.Ace) == 14
    expect is_red(Card { suit: Hearts, rank: Queen }) and
      not is_red(Card { suit: Spades, rank: Queen })
    expect len(spanish48()) == 48 and len(spanish40()) == 40
    expect all(c in spanish40() : c.rank != SpanishRank.Eight and c.rank != SpanishRank.Nine)
    expect spanish_number(SpanishRank.Ace) == 1 and spanish_number(Knight) == 11
    expect len(skat32()) == 32 and all(c in skat32() : ord(c.rank) >= ord(Rank.Seven))
    expect len(wizard60()) == 60 and count(c in wizard60() : is_wizard(c)) == 4
    expect count(c in wizard60() : is_jester(c)) == 4
  }

  test "std.poker" {
    expect hand_rank(
      hand_value(
        [
          Card { suit: Hearts, rank: r }
          for r in [Rank.Ace, Rank.King, Rank.Queen, Rank.Jack, Rank.Ten]
        ]
      )
    ) ==
      StraightFlush
    expect hand_rank(
      hand_value(
        [Card { suit: Hearts, rank: r } for r in [Rank.Ace, Rank.King, Rank.Queen, Rank.Jack]] +
          [Card { suit: Spades, rank: Rank.Ten }]
      )
    ) ==
      Straight
    expect hand_value([Card { suit: Clubs, rank: Rank.Two }]) == encode(0, [2])
    expect straight_high([true, true, true, true] + [false for i in 0..7] + [true]) == 5
  }

  test "std.betting" {
    // A va all-in con 50, B y C ponen 200 y D se retira tras poner 20.
    expect pots([50, 200, 200, 20], [true, true, true, false]) == [(170, [0, 1, 2]), (300, [1, 2])]
    // A tiene la mejor mano y B y C empatan: A gana el principal y B y C se reparten el otro.
    expect winnings([50, 200, 200, 20], [true, true, true, false], [9, 5, 5, 0], [0, 1, 2, 3]) ==
      [170, 150, 150, 0]
    // Fichas impares: la que sobra, al primero según el orden.
    expect winnings([3, 3, 1], [true, true, false], [1, 1, 0], [1, 0, 2]) == [3, 4, 0]
    expect to_call([10, 40, 0], 0, 100) == 30 and to_call([10, 40, 0], 2, 25) == 25
  }

  test "std.tricktaking" {
    expect can_play([0, 1, -1], 1, 0) == false and can_play([0, 1, -1], -1, 0)
    expect can_play([1, 2], 2, 0) and can_play([0, 1], 0, 0) and can_play([0], 1, -1)
    expect first_suit([-1, -1, 2, 0]) == 2 and first_suit([-1]) == -1
    expect trick_key(3, 5, 1, 3) == 2005 and trick_key(1, 5, 1, 3) == 1005
    expect trick_key(2, 9, 1, 3) == 0 and trick_key(1, 5, 1, -1) == 1005
    expect trick_winner([1005, 1012, 0, 2002]) == 3 and trick_winner([0, 0, 0]) == 0
    expect trick_order(0) == [0]
  }

  test "std.dice" {
    expect faces(6) == [1, 2, 3, 4, 5, 6]
    expect count_face([2, 5, 2, 1], 2) == 2 and count_with_wild([2, 5, 2, 1], 2, 1) == 3
    expect sum_face([3, 3, 4], 3) == 6
    expect most_repeated([4, 1, 4, 4, 2]) == 3 and most_repeated([]) == 0
    expect all_same([5, 5, 5]) and not all_same([5, 1])
    expect is_straight([3, 5, 4, 2]) and not is_straight([1, 2, 2, 3]) and not is_straight([])
  }

  test "std.grid" {
    expect len(all_directions()) == 8 and (0, 1) in orthogonal() and (1, 1) in diagonal()
    expect shift((2, 3), (-1, 1)) == (1, 4)
    expect ray((0, 0), (1, 1), 3) == [(1, 1), (2, 2), (3, 3)] and ray((0, 0), (1, 0), 0) == []
    expect manhattan((0, 0), (2, 3)) == 5 and chebyshev((0, 0), (2, 3)) == 3
    expect adjacent((1, 1), (1, 2)) and not adjacent((1, 1), (2, 2)) and touching((1, 1), (2, 2))
  }

  test "std.boards" {
    expect len(queen_directions()) == 8 and len(knight_jumps()) == 8
    expect ray_within((0, 0), (1, 1), 3, 3) == [(1, 1), (2, 2)] and
      ray_within((0, 0), (-1, 0), 8, 8) == []
    expect len(hops_within((0, 0), knight_jumps(), 8, 8)) == 2
    expect len(hops_within((3, 3), knight_jumps(), 8, 8)) == 8
    expect within((7, 7), 8, 8) and not within((8, 0), 8, 8) and not within((0, -1), 8, 8)
    expect loop_path(66, 68, 4) == [66, 67, 0, 1]
    expect advance_on(70, 5, 76) == 75 and is_none(advance_on(70, 6, 76))
    expect passes(3, 4) == [4, 5, 6, 7]
  }

  test "std.graph" {
    expect cycle(4) == [(0, 1), (1, 2), (2, 3), (3, 0)]
    expect neighbors_of(cycle(4), 0) == [1, 3] and successors(cycle(4), 0) == [1]
    expect connected(cycle(4), 3, 0) and not connected(cycle(4), 0, 2)
    expect degree(cycle(4), 2) == 2 and advance(3, 2, 4) == 1
  }
}
