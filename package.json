{
  "name": "gamehub",
  "private": true,
  "type": "module",
  "description": "Monorepo de GameHub: la parte de JavaScript (web/ y las UIs propias de games/*/ui).",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @gamehub/play dev",
    "build": "pnpm --filter @gamehub/play --filter @gamehub/studio-app build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "biome check",
    "format": "biome check --write",
    "dev:studio": "pnpm --filter @gamehub/studio-app dev"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
