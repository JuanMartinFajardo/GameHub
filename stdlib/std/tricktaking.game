// Juegos de bazas: quién puede jugar qué y quién se lleva la baza.
//
// Cada juego decide cómo se ve cada carta en una baza: su **palo efectivo** (un número; en el
// Skat, las sotas son del palo de triunfo; −1 = una carta que no tiene palo y se puede jugar
// siempre, como el mago y el bufón de Wizard) y su **fuerza** dentro del palo. Con eso, estas
// funciones sirven para cualquier baraja.
//
//   import std.tricktaking.{can_play, trick_key, trick_winner}

/// ¿Se puede jugar una carta de palo efectivo `card` si en la baza se pide `led` (−1: no se pide
/// nada) y en la mano quedan cartas de los palos `hand`? Hay que asistir al palo pedido si se
/// tiene; las cartas sin palo valen siempre.
fn can_play(hand: List<Int>, card: Int, led: Int) -> Bool =
  card < 0 or led < 0 or card == led or led not in hand

/// El primer palo de la baza (−1 si todavía no hay ninguna carta con palo).
fn first_suit(suits: List<Int>) -> Int = first([s for s in suits if s >= 0] + [-1])

/// Clave de una carta en la baza para decidir quién gana: un triunfo gana a cualquier carta del
/// palo pedido, y esta a las de los demás palos, que no pueden ganar; dentro de cada grupo, la de
/// más fuerza. `trump` = −1 si no hay triunfo.
fn trick_key(suit: Int, power: Int, led: Int, trump: Int) -> Int = case {
  trump >= 0 and suit == trump => 2000 + power
  led >= 0 and suit == led => 1000 + power
  else => 0
}

/// La posición en la baza de la carta que gana: la de clave más alta y, si empatan, la primera
/// que se jugó.
fn trick_winner(keys: List<Int>) -> Int = argmax(i in 0..<len(keys) : keys[i])

/// Quién juega cada carta de una baza que abre `leader`: en orden, desde él.
fn trick_order(leader: Seat) -> List<Seat> = seats_from(leader)
